[
  {
    "name": "Sub-workflow: Create Lead from Chat",
    "nodes": [
      {
        "parameters": {},
        "id": "sub-trigger-create-lead-001",
        "name": "Execute Workflow Trigger",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1,
        "position": [
          0,
          100
        ]
      },
      {
        "parameters": {
          "jsCode": "const input = $input.first().json || {};\nconst rawText = (input.raw_text || '').toString().trim();\n\nif (!rawText) {\n  throw new Error('No se proporcionó texto de entrada (raw_text) para crear el lead.');\n}\n\nreturn [{\n  json: {\n    raw_text: rawText\n  }\n}];"
        },
        "id": "norm-text-001",
        "name": "Normalizar Raw Text",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          220,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"Eres un extractor de información comercial experto. Extrae de forma estructurada los datos del lead a partir del texto ingresado por el usuario.\\n\\nREGLAS DE EXTRACCIÓN:\\n- full_name: Nombre y apellido del lead (OBLIGATORIO). Si no hay nombre de persona claro, responde null.\\n- email: Correo electrónico o null.\\n- phone: Teléfono o null.\\n- source: Canal de origen mencionado o 'chat'.\\n- notes: Detalles extras, intereses u observaciones mencionadas o null.\\n- company_name: Nombre de la empresa u organización mencionada o null.\\n\\nCRÍTICO: Responde ÚNICAMENTE con este JSON plano, sin markdown, sin texto extra:\\n{\\n  \\\"full_name\\\": string|null,\\n  \\\"email\\\": string|null,\\n  \\\"phone\\\": string|null,\\n  \\\"source\\\": string,\\n  \\\"notes\\\": string|null,\\n  \\\"company_name\\\": string|null\\n}\\n\\nTexto del usuario: {{ $json.raw_text }}\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":2000,\"responseMimeType\":\"application/json\"}}",
          "options": {},
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi"
        },
        "id": "gemini-extract-lead-001",
        "name": "Extraer Datos con Gemini",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          440,
          100
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "YOUR_GEMINI_CREDENTIAL_ID",
            "name": "Google Gemini API Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst rawText = $('Normalizar Raw Text').first().json.raw_text;\n\nlet text = '';\ntry {\n  text = response.candidates[0].content.parts[0].text;\n} catch(e) {\n  text = '{}';\n}\n\nconst cleaned = text.replace(/```json\\n?/gi, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {};\n}\n\nconst fullName = parsed.full_name ? String(parsed.full_name).trim() : null;\nconst email = parsed.email ? String(parsed.email).trim().toLowerCase() : null;\nconst phone = parsed.phone ? String(parsed.phone).trim() : null;\nconst source = parsed.source ? String(parsed.source).trim() : 'chat';\nconst notes = parsed.notes ? String(parsed.notes).trim() : null;\nconst companyName = parsed.company_name ? String(parsed.company_name).trim() : null;\n\nreturn [{\n  json: {\n    raw_text: rawText,\n    full_name: fullName,\n    has_full_name: !!fullName,\n    email,\n    phone,\n    source,\n    notes,\n    company_name: companyName\n  }\n}];"
        },
        "id": "parse-extracted-lead-001",
        "name": "Parsear Datos Extraidos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          660,
          100
        ]
      },
      {
        "parameters": {
          "conditions": {
            "boolean": [
              {
                "value1": "={{ $json.has_full_name }}",
                "value2": true
              }
            ]
          }
        },
        "id": "if-has-fullname-001",
        "name": "IF Nombre Valido",
        "type": "n8n-nodes-base.if",
        "typeVersion": 1,
        "position": [
          880,
          100
        ]
      },
      {
        "parameters": {
          "values": {
            "boolean": [
              {
                "name": "success",
                "value": false
              }
            ],
            "string": [
              {
                "name": "error",
                "value": "No se pudo extraer el nombre completo del lead. Por favor especifica un nombre válido para crear el registro."
              }
            ]
          },
          "options": {}
        },
        "id": "output-error-no-fullname-001",
        "name": "Respuesta Error Nombre Faltante",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          1100,
          280
        ]
      },
      {
        "parameters": {
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "supabaseApi",
          "method": "GET",
          "url": "=https://kgrfhfwtcanthrymmvkb.supabase.co/rest/v1/companies?select=id,name&name=ilike.*{{ encodeURIComponent($json.company_name || '') }}*&limit=1",
          "sendHeaders": true,
          "specifyHeaders": "keypair",
          "headerParameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "={{ $credentials.supabaseApi.serviceKey }}"
              },
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $credentials.supabaseApi.serviceKey }}"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ]
          },
          "options": {}
        },
        "id": "get-company-by-name-001",
        "name": "Consultar Empresa (si aplica)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          1100,
          100
        ],
        "credentials": {
          "supabaseApi": {
            "id": "YOUR_SUPABASE_CREDENTIAL_ID",
            "name": "Supabase Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const companyResponse = $input.first().json;\nconst leadData = $('Parsear Datos Extraidos').first().json;\n\nlet companyId = null;\nif (Array.isArray(companyResponse) && companyResponse.length > 0 && companyResponse[0].id) {\n  companyId = companyResponse[0].id;\n} else if (companyResponse && companyResponse.id) {\n  companyId = companyResponse.id;\n}\n\nreturn [{\n  json: {\n    automation_id: 'sub_create_lead_agent',\n    full_name: leadData.full_name,\n    email: leadData.email,\n    phone: leadData.phone,\n    source: leadData.source || 'chat',\n    status: 'nuevo',\n    company_id: companyId,\n    notes: leadData.notes\n  }\n}];"
        },
