        "id": "get-deals-summary-001",
        "name": "Consultar Deals de Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          660,
          100
        ],
        "credentials": {
          "supabaseApi": {
            "id": "YOUR_SUPABASE_CREDENTIAL_ID",
            "name": "Supabase Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const leadItems = $('Consultar Leads de Supabase').all().map(i => i.json);\nconst dealItems = $('Consultar Deals de Supabase').all().map(i => i.json);\nconst params = $('Normalizar Fechas y Parametros').first().json;\n\nconst leads = (leadItems.length === 1 && Array.isArray(leadItems[0])) ? leadItems[0] : leadItems.filter(l => l && l.id);\nconst deals = (dealItems.length === 1 && Array.isArray(dealItems[0])) ? dealItems[0] : dealItems.filter(d => d && d.id);\n\nconst newLeads = leads.length;\nconst hotLeads = leads.filter(l => (l.ai_category || '').toLowerCase() === 'hot').length;\n\nconst dealsByStage = {};\nlet wonDealsCount = 0;\nlet wonDealsTotalValue = 0;\nlet highRiskDealsCount = 0;\n\ndeals.forEach(d => {\n  const stage = (d.stage || 'sin_etapa').toLowerCase();\n  dealsByStage[stage] = (dealsByStage[stage] || 0) + 1;\n\n  if (stage === 'ganado') {\n    wonDealsCount++;\n    wonDealsTotalValue += Number(d.value || 0);\n  }\n\n  if ((d.ai_risk_score || 0) >= 65) {\n    highRiskDealsCount++;\n  }\n});\n\nconst metrics = {\n  date_from: params.date_from,\n  date_to: params.date_to,\n  new_leads_count: newLeads,\n  hot_leads_count: hotLeads,\n  won_deals_count: wonDealsCount,\n  won_deals_total_value: wonDealsTotalValue,\n  active_high_risk_deals_count: highRiskDealsCount,\n  deals_by_stage: dealsByStage,\n  total_deals_count: deals.length\n};\n\nreturn [{\n  json: {\n    automation_id: params.automation_id,\n    metrics\n  }\n}];"
        },
        "id": "calc-metrics-001",
        "name": "Calcular Metricas Comercial",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          880,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"Eres el analista ejecutivo de IA de Orbit CRM. Redacta un informe comercial ejecutivo basándote ESTRICTAMENTE en este JSON de métricas del período:\\n{{ JSON.stringify($json.metrics) }}\\n\\nREGLAS DE REDACCIÓN:\\n- Escribe exactamente 2 párrafos cortos y directos.\\n- Tono profesional, ágil y ejecutivo.\\n- Usa máximo 3 emojis en todo el texto.\\n- Menciona la cantidad de leads nuevos y la cantidad de leads 'Hot'.\\n- Menciona el valor financiero total acumulado de los negocios ganados ($ {{ $json.metrics.won_deals_total_value }}).\\n- Si hay negocios con riesgo alto (active_high_risk_deals_count > 0), menciónalo con prioridad.\\n- NUNCA inventes números ni datos que no estén en el JSON.\\n\\nFORMATO:\\n- Texto Markdown limpio, sin bloques de código (sin ```markdown), sin comillas triples.\"}]}],\"generationConfig\":{\"temperature\":0.3,\"maxOutputTokens\":2000}}",
          "options": {},
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi"
        },
        "id": "gemini-summary-001",
        "name": "Redactar Resumen con Gemini",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          1100,
          100
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "YOUR_GEMINI_CREDENTIAL_ID",
            "name": "Google Gemini API Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst metricsData = $('Calcular Metricas Comercial').first().json;\n\nlet text = '';\ntry {\n  text = response.candidates[0].content.parts[0].text;\n} catch(e) {\n  text = 'Resumen comercial generado para el periodo del ' + metricsData.metrics.date_from + ' al ' + metricsData.metrics.date_to + '.';\n}\n\nconst sanitized = text\n  .replace(/```markdown\\n?/gi, '')\n  .replace(/```json\\n?/gi, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\nreturn [{\n  json: {\n    automation_id: metricsData.automation_id,\n    metrics: metricsData.metrics,\n    summary_text: sanitized\n  }\n}];"
        },
