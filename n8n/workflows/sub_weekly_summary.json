    "name": "Sub-workflow: Weekly Summary",
    "nodes": [
      {
        "parameters": {},
        "id": "sub-trigger-summary-001",
        "name": "Execute Workflow Trigger",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1,
        "position": [
          0,
          100
        ]
      },
      {
        "parameters": {
          "jsCode": "const input = $input.first().json || {};\nconst now = new Date();\n\nlet dateTo = input.date_to ? new Date(input.date_to) : now;\nif (isNaN(dateTo.getTime())) dateTo = now;\n\nlet dateFrom = input.date_from ? new Date(input.date_from) : new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nif (isNaN(dateFrom.getTime())) dateFrom = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    automation_id: '48a75e32-9015-4394-aa67-750034e0ff0b',\n    date_from: dateFrom.toISOString(),\n    date_to: dateTo.toISOString()\n  }\n}];"
        },
        "id": "norm-dates-001",
        "name": "Normalizar Fechas y Parametros",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          220,
          100
        ]
      },
      {
        "parameters": {
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "supabaseApi",
          "method": "GET",
