        "id": "respond-chat-webhook-001",
        "name": "Responder Webhook Chat",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1450, 100]
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json || {};\nconst eventType = (body.event_type || body.type || 'lead_created').toString().trim().toLowerCase();\nconst leadId = body.lead_id || body.record?.id || null;\nconst dealId = body.deal_id || body.record?.id || null;\n\nlet targetAction = 'qualify_lead';\nif (eventType.includes('deal')) {\n  targetAction = 'assess_deal_risk';\n}\n\nreturn [{\n  json: {\n    event_type: eventType,\n    target_action: targetAction,\n    lead_id: leadId,\n    deal_id: dealId\n  }\n}];"
        },
        "id": "parse-crm-event-001",
        "name": "Parsear Evento CRM Directo",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [220, 500]
      },
      {
        "parameters": {
