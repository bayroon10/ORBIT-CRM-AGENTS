        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [0, 100],
        "webhookId": "orbit-crm-webhook-chat"
      },
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "crm-event",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "webhook-crm-event-001",
        "name": "Webhook /crm-event",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [0, 500],
        "webhookId": "orbit-crm-webhook-crm-event"
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 8 * * 1"
              }
            ]
          }
        },
        "id": "schedule-cron-001",
        "name": "Schedule Cron Semanal",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.1,
        "position": [0, 900]
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json || {};\nconst message = (body.message || body.text || '').toString().trim();\n\nif (!message) {\n  throw new Error('El payload del chat no contiene ningún mensaje (campo message).');\n}\n\nreturn [{ json: { message } }];"
        },
        "id": "norm-chat-message-001",
        "name": "Normalizar Mensaje Chat",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [220, 100]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"Eres el Orquestador IA de Orbit CRM. Tu tarea es analizar el mensaje del usuario y clasificar la intención en UNA de las 5 capacidades disponibles:\\n\\n1. query_crm: Para consultar o preguntar datos del CRM en lenguaje natural (ej: 'cuántos leads tengo', 'cuál es mi deal más grande').\\n2. create_lead: Para ingresar o registrar un nuevo lead a partir de datos en el texto (ej: 'cargá a Juan Perez, juan@email.com').\\n3. get_summary: Para solicitar un resumen o reporte de métricas del CRM (ej: 'dame el resumen semanal', 'resumen de ventas').\\n4. qualify_lead: Para solicitar la calificación o scoring de un lead específico mediante su ID (ej: 'califica el lead UUID').\\n5. assess_deal_risk: Para analizar el riesgo de un negocio o deal específico mediante su ID (ej: 'evalua el riesgo del deal UUID').\\n\\nESTRUCTURA DE RESPUESTA JSON:\\n{\\n  \\\"intent\\\": \\\"query_crm\\\" | \\\"create_lead\\\" | \\\"get_summary\\\" | \\\"qualify_lead\\\" | \\\"assess_deal_risk\\\",\\n  \\\"params\\\": {\\n    \\\"question\\\": string,\\n    \\\"raw_text\\\": string,\\n    \\\"lead_id\\\": string|null,\\n    \\\"deal_id\\\": string|null,\\n    \\\"date_from\\\": string|null,\\n    \\\"date_to\\\": string|null\\n  }\\n}\\n\\nMensaje del usuario: {{ $json.message }}\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":2000,\"responseMimeType\":\"application/json\"}}",
          "options": {}
        },
        "id": "gemini-router-001",
        "name": "Clasificar Intencion Chat (Gemini Router)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [440, 100],
        "credentials": {
          "googlePalmApi": {
            "id": "YOUR_GEMINI_CREDENTIAL_ID",
            "name": "Google Gemini API Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst userMessage = $('Normalizar Mensaje Chat').first().json.message;\n\nlet text = '';\ntry {\n  text = response.candidates[0].content.parts[0].text;\n} catch(e) {\n  text = '{}';\n}\n\nconst cleaned = text.replace(/```json\\n?/gi, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = { intent: 'query_crm', params: { question: userMessage } };\n}\n\nconst validIntents = ['query_crm', 'create_lead', 'get_summary', 'qualify_lead', 'assess_deal_risk'];\nconst intent = validIntents.includes(parsed.intent) ? parsed.intent : 'query_crm';\nconst params = parsed.params || {};\n\nreturn [{\n  json: {\n    message: userMessage,\n    intent,\n    params: {\n      question: params.question || userMessage,\n      raw_text: params.raw_text || userMessage,\n      lead_id: params.lead_id || null,\n      deal_id: params.deal_id || null,\n      date_from: params.date_from || null,\n      date_to: params.date_to || null\n    }\n  }\n}];"
        },
        "id": "parse-router-001",
        "name": "Parsear Intencion Router",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [660, 100]
      },
      {
        "parameters": {
          "dataType": "string",
          "value1": "={{ $json.intent }}",
          "rules": {
            "rules": [
              { "value2": "query_crm", "output": 0 },
              { "value2": "create_lead", "output": 1 },
              { "value2": "get_summary", "output": 2 },
              { "value2": "qualify_lead", "output": 3 },
              { "value2": "assess_deal_risk", "output": 4 }
            ]
          },
          "fallbackOutput": 0
        },
        "id": "switch-chat-intent-001",
        "name": "Switch Intencion Chat",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 1,
        "position": [880, 100]
      },
      {
        "parameters": {
          "workflowId": "sub_query_crm",
          "workflowInputs": {
            "mappingMode": "defineBelow",
            "value": {
              "question": "={{ $json.params.question }}"
            }
          }
        },
        "id": "exec-tool-query-crm-001",
        "name": "Tool: query_crm (sub_query_crm.json)",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1,
        "position": [1140, -100]
