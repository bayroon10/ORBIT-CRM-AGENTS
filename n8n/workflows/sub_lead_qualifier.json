      {
        "parameters": {
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "supabaseApi",
          "method": "GET",
          "url": "=https://kgrfhfwtcanthrymmvkb.supabase.co/rest/v1/leads?id=eq.{{ $json.lead_id }}&select=id,full_name,email,phone,source,status,company_id,created_at",
          "sendHeaders": true,
          "specifyHeaders": "keypair",
          "headerParameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "={{ $credentials.supabaseApi.serviceKey }}"
              },
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $credentials.supabaseApi.serviceKey }}"
              }
            ]
          },
          "options": {}
        },
        "id": "get-lead-001",
        "name": "Obtener Lead",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          220,
          100
        ],
        "credentials": {
          "supabaseApi": {
            "id": "YOUR_SUPABASE_CREDENTIAL_ID",
            "name": "Supabase Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst leadData = Array.isArray(input) ? input[0] : input;\n\nif (!leadData || !leadData.id) {\n  throw new Error('Lead no encontrado en Supabase con el lead_id proporcionado.');\n}\n\nreturn [{\n  json: {\n    automation_id: '2a8b592d-fc8b-423a-b0b5-66793b480e37',\n    lead_id: leadData.id,\n    full_name: (leadData.full_name || 'Sin nombre').trim(),\n    email: (leadData.email || '').trim().toLowerCase(),\n    phone: (leadData.phone || 'Sin telefono').trim(),\n    source: (leadData.source || 'web').trim(),\n    status: (leadData.status || 'nuevo').trim(),\n    company_id: leadData.company_id || null\n  }\n}];"
        },
        "id": "validate-lead-001",
        "name": "Validar y Normalizar Datos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          440,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"Eres un experto en ventas B2B. Analiza este lead y devuelve ÚNICAMENTE un JSON válido (sin markdown, sin texto extra) con la estructura:\\n{\\\"score\\\": number(0-100), \\\"category\\\": string(\\\"Hot\\\"|\\\"Warm\\\"|\\\"Cold\\\"), \\\"summary\\\": string(max 80 chars), \\\"next_step\\\": string(max 100 chars)}.\\n\\nDatos del lead:\\nNombre: {{ $json.full_name }}\\nEmail: {{ $json.email }}\\nTeléfono: {{ $json.phone }}\\nFuente: {{ $json.source }}\\nEstado: {{ $json.status }}\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":2000,\"responseMimeType\":\"application/json\"}}",
          "options": {},
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi"
        },
        "id": "gemini-analyze-001",
        "name": "Analizar con Gemini",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          660,
          100
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "YOUR_GEMINI_CREDENTIAL_ID",
            "name": "Google Gemini API Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst leadInfo = $('Validar y Normalizar Datos').first().json;\nconst automationId = leadInfo.automation_id;\nconst leadId = leadInfo.lead_id;\n\nlet text = '';\ntry {\n  text = response.candidates[0].content.parts[0].text;\n} catch(e) {\n  throw new Error('Respuesta de Gemini con estructura inesperada: ' + JSON.stringify(response));\n}\n\nconst cleaned = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {\n    score: 50,\n    category: 'Warm',\n    summary: 'Análisis no disponible temporalmente.',\n    next_step: 'Contactar al lead para obtener más información.'\n  };\n}\n\nconst score = Math.min(100, Math.max(0, parseInt(parsed.score) || 50));\nconst validCategories = ['Hot', 'Warm', 'Cold'];\nconst category = validCategories.includes(parsed.category) ? parsed.category : 'Warm';\n\nreturn [{\n  json: {\n    automation_id: automationId,\n    lead_id: leadId,\n    ai_score: score,\n    ai_category: category,\n    ai_summary: (parsed.summary || '').substring(0, 200),\n    ai_next_step: (parsed.next_step || '').substring(0, 300),\n    ai_analyzed_at: new Date().toISOString()\n  }\n}];"
        },
        "id": "parse-ai-001",
        "name": "Parsear JSON de IA",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          880,
          100
