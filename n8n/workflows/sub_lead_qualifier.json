          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ ai_score: $json.ai_score, ai_category: $json.ai_category, ai_summary: $json.ai_summary, ai_next_step: $json.ai_next_step, ai_analyzed_at: $json.ai_analyzed_at }) }}",
          "options": {}
        },
