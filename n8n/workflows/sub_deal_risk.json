              }
            ]
          },
          "options": {}
        },
        "id": "get-deal-001",
        "name": "Obtener Deal",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          220,
          100
        ],
        "credentials": {
          "supabaseApi": {
            "id": "YOUR_SUPABASE_CREDENTIAL_ID",
            "name": "Supabase Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst dealData = Array.isArray(input) ? input[0] : input;\n\nif (!dealData || !dealData.id) {\n  throw new Error('Deal no encontrado en Supabase con el deal_id proporcionado.');\n}\n\nreturn [{\n  json: {\n    automation_id: 'c621c63b-8f48-45b1-b255-f7a1b5d6d03c',\n    deal_id: dealData.id,\n    title: (dealData.title || 'Sin titulo').trim(),\n    value: dealData.value || 0,\n    stage: (dealData.stage || 'prospecto').trim(),\n    probability: dealData.probability ?? 50,\n    expected_close: dealData.expected_close || 'No especificada',\n    stalled: !!dealData.stalled,\n    updated_at: dealData.updated_at || new Date().toISOString(),\n    tasks: dealData.tasks || [],\n    activities: dealData.activities || []\n  }\n}];"
        },
        "id": "validate-deal-001",
        "name": "Validar y Normalizar Datos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          440,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"Eres un analista B2B experto en ventas. Tu tarea es evaluar el riesgo de que este negocio NO se cierre.\\n\\nRAZONA paso a paso siguiendo este Chain-of-Thought:\\n1. INACTIVIDAD: ¿Cuántos días pasaron desde la última actualización? ¿Hay silencio operativo?\\n2. TAREAS: ¿Hay tareas vencidas o sin completar críticas? ¿Cuántas y cuáles?\\n3. ACTIVIDAD: ¿El historial de actividades muestra compromiso reciente del cliente?\\n4. TIEMPO: ¿El cierre esperado ya pasó o está próximo sin avances claros?\\n5. CONCLUSIÓN: Con base en los 4 puntos anteriores, determina el nivel de riesgo.\\n\\nDatos del deal:\\n- Título: {{ $json.title }}\\n- Etapa: {{ $json.stage }}\\n- Valor: {{ $json.value }}\\n- Probabilidad: {{ $json.probability }}%\\n- Cierre esperado: {{ $json.expected_close }}\\n- Última actualización: {{ $json.updated_at }}\\n- Estancado: {{ $json.stalled }}\\n- Tareas: {{ JSON.stringify($json.tasks) }}\\n- Actividades: {{ JSON.stringify($json.activities) }}\\n\\nHoy es {{ $now }}.\\n\\nCRÍTICO: Responde ÚNICAMENTE con este JSON plano, sin bloques markdown, sin texto extra:\\n{\\\"score\\\": <0-100, donde 100=pérdida casi segura>, \\\"factors\\\": \\\"<1 oración: factor de riesgo más urgente o confirmación de estado sano>\\\"}\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":2000,\"responseMimeType\":\"application/json\"}}",
          "options": {},
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi"
        },
        "id": "gemini-analyze-deal-001",
        "name": "Analizar Riesgo con Gemini",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 3,
        "position": [
          660,
          100
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "YOUR_GEMINI_CREDENTIAL_ID",
            "name": "Google Gemini API Account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst dealInfo = $('Validar y Normalizar Datos').first().json;\nconst automationId = dealInfo.automation_id;\nconst dealId = dealInfo.deal_id;\n\nlet text = '';\ntry {\n  text = response.candidates[0].content.parts[0].text;\n} catch(e) {\n  throw new Error('Estructura de respuesta Gemini inesperada: ' + JSON.stringify(response).substring(0, 200));\n}\n\nconst cleaned = text\n  .replace(/```json\\n?/gi, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try { parsed = JSON.parse(jsonMatch[0]); } catch(e2) { parsed = null; }\n  }\n}\n\nif (!parsed) {\n  parsed = {\n    score: 50,\n    factors: 'No se pudo analizar el riesgo. Verificar respuesta de Gemini.'\n  };\n}\n\nconst score = Math.min(100, Math.max(0, parseInt(parsed.score) || 50));\n\nreturn [{\n  json: {\n    automation_id: automationId,\n    deal_id: dealId,\n    ai_risk_score: score,\n    ai_risk_factors: (parsed.factors || '').substring(0, 500),\n    ai_analyzed_at: new Date().toISOString()\n  }\n}];"
        },
